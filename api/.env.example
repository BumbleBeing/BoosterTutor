DATABASE_URL=postgresql://user:password@host:5432/dbname
ANTHROPIC_API_KEY=sk-ant-usr-key

# The Admin Key (ADR 0031 s2): lets requests with a matching X-Admin-Key header
# call Claude. Leave unset to switch admin off. A wrong key is a plain 401 with
# no rate limit, so use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_KEY=

# Draft Review (all optional; defaults are in config.py)
# SUPPORTED_SETS=hob
# FETCH_LIMIT_PER_MINUTE=5
# FETCH_LIMIT_PER_DAY=40
# Set a long random value in production; clients are stored as a salted hash.
# CLIENT_HASH_SALT=
# Proxies in front of the API that append to X-Forwarded-For (0 = none).
# PROXY_HOPS=0
